{
  "_note": "SeedVR2 3B: obraz -> 1080p (jak wideo, jedna klatka).",
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "%IMAGE%"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "%VAE%"
    }
  },
  "7": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "%UNET%",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "upscale_method": "lanczos",
      "width": "%WIDTH%",
      "height": "%HEIGHT%",
      "crop": "disabled"
    }
  },
  "4": {
    "class_type": "SeedVR2Preprocess",
    "inputs": {
      "resized_images": [
        "3",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": [
        "4",
        0
      ],
      "vae": [
        "5",
        0
      ],
      "tile_size": 1024,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "12": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "5",
        0
      ],
      "tile_size": 1024,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "13": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "original_resized_images": [
        "3",
        0
      ],
      "color_correction_method": "lab"
    }
  },
  "9": {
    "class_type": "SeedVR2Conditioning",
    "inputs": {
      "model": [
        "7",
        0
      ],
      "vae_conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%SEED%",
      "steps": 1,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "7",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "latent_image": [
        "6",
        0
      ]
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "13",
        0
      ],
      "filename_prefix": "aistudio_1080p"
    }
  }
}